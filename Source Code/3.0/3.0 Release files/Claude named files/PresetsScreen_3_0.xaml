<UserControl x:Class="RandomCreation.PresetsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomCreation"
             Background="{DynamicResource BackgroundOuterBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Title bar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundTitleBarBrush}"
                BorderBrush="{DynamicResource BorderStandardBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Button Click="BackButton_Click" Cursor="Hand"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="← " Foreground="{DynamicResource AccentBlueBrush}" FontSize="14"/>
                                    <TextBlock Text="Back" Foreground="{DynamicResource AccentBlueBrush}" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBackButtonBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="Presets" Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Click="SaveCurrentButton_Click" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource AccentBlueBrush}" CornerRadius="8" Padding="12,6">
                                <TextBlock Text="＋  Save Current" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBlueHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1">
            <TextBlock x:Name="EmptyText"
                       Text="No presets yet. Hit Save Current to create one."
                       Foreground="{DynamicResource EmptyStateBrush}"
                       FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PresetsList"
                              AllowDrop="True"
                              Drop="PresetsList_Drop"
                              PreviewMouseLeftButtonDown="PresetsList_PreviewMouseDown"
                              PreviewMouseMove="PresetsList_PreviewMouseMove">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PresetViewModel}">
                            <Border x:Name="PresetRowBorder"
                                    Background="{DynamicResource BackgroundCardBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderStandardBrush}"
                                    BorderThickness="3,1,1,1"
                                    Margin="0,0,0,8"
                                    Tag="{Binding}"
                                    MouseLeftButtonUp="PresetRow_Click"
                                    Cursor="Hand">

                                <StackPanel>
                                    <!-- ── Main row ── -->
                                    <Border Padding="12,10" Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>  <!-- Drag -->
                                                <ColumnDefinition Width="*"/>     <!-- Name + summary -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Load -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Duplicate -->
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="⠿"
                                                       Foreground="{DynamicResource BorderSelectedBrush}"
                                                       FontSize="14" VerticalAlignment="Center"
                                                       Margin="0,0,10,0" Cursor="SizeAll"
                                                       Tag="{Binding}"
                                                       MouseMove="DragHandle_MouseMove"/>

                                            <!-- Name (inline edit on second click) + summary -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="PresetNameBlock"
                                                           Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="14" FontWeight="Medium"
                                                           MouseLeftButtonUp="PresetNameBlock_Click"
                                                           Cursor="Hand"/>
                                                <TextBox x:Name="PresetNameBox"
                                                         FontSize="14" FontWeight="Medium"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         Background="{DynamicResource BackgroundExpandedBrush}"
                                                         BorderBrush="{DynamicResource AccentBlueBrush}"
                                                         BorderThickness="1"
                                                         Padding="3,1"
                                                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                         Visibility="Collapsed"
                                                         Tag="{Binding}"
                                                         KeyDown="PresetNameBox_KeyDown"
                                                         LostFocus="PresetNameBox_LostFocus"/>
                                                <TextBlock Text="{Binding Summary}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Load button -->
                                            <Button Grid.Column="2"
                                                    Click="LoadPresetButton_Click"
                                                    Tag="{Binding}"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    Margin="8,0,4,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource PillOnBackgroundBrush}"
                                                                BorderBrush="{DynamicResource PillOnBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6" Padding="10,4">
                                                            <TextBlock Text="Load"
                                                                       Foreground="{DynamicResource PillOnForegroundBrush}"
                                                                       FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource HoverDarkBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Duplicate button -->
                                            <Button Grid.Column="3"
                                                    Click="DuplicatePresetButton_Click"
                                                    Tag="{Binding}"
                                                    Cursor="Hand" VerticalAlignment="Center"
                                                    ToolTip="Duplicate (Ctrl+D)">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                CornerRadius="4" Padding="6,4">
                                                            <TextBlock Text="⧉"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="14"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource HoverDarkBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- ── Expanded detail ── -->
                                    <Border Visibility="{Binding ExpandedVisibility}"
                                            Background="{DynamicResource BackgroundExpandedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="16,10"
                                            CornerRadius="0,0,8,8">
                                        <ItemsControl ItemsSource="{Binding CollectionDisplayInfo}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:PresetCollectionDisplayInfo}">
                                                    <Grid Margin="0,3,0,3" Opacity="{Binding RowOpacity}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding CollectionName}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="13" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding StatsLabel}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Margin="12,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>

                                <!-- Selection trigger -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="PresetRowBorder" Property="BorderBrush"
                                            Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter TargetName="PresetRowBorder" Property="Background"
                                            Value="{DynamicResource SelectedCategoryBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
