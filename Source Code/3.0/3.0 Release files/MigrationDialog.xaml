<Window x:Class="RandomCreation.MigrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        Width="460" Height="Auto"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        SizeToContent="Height">

    <Border Background="{DynamicResource DialogBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Data Updated to v3.0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="15" FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- Message body -->
            <StackPanel Grid.Row="1" Margin="0,0,0,0">

                <TextBlock Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="13" TextWrapping="Wrap"
                           Margin="0,0,0,10">
                    Your collections have been updated to the new v3.0 format.
                    A <Run FontWeight="SemiBold">Category Group</Run> has been created
                    inside each collection, named after that collection, containing all
                    of its existing categories.
                </TextBlock>

                <TextBlock Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="13" TextWrapping="Wrap"
                           Margin="0,0,0,10">
                    Your categories and options are intact. You can rename, split,
                    or reorganise groups at any time in Manage Content.
                </TextBlock>

                <!-- History / presets cleared notice -->
                <Border Background="{DynamicResource BackgroundCardBrush}"
                        CornerRadius="6" Padding="12,10"
                        Margin="0,0,0,0">
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="12" TextWrapping="Wrap">
                        Generation history and presets have been cleared because they
                        reference the old flat structure. You can save a backup of your
                        history before continuing.
                    </TextBlock>
                </Border>

            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">

                <!-- Save Backup -->
                <Button x:Name="SaveBackupButton" Click="SaveBackupButton_Click"
                        Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource ButtonDarkBrush}"
                                    CornerRadius="6" Padding="18,7">
                                <TextBlock x:Name="BtnText"
                                           Text="Save Backup"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Continue -->
                <Button x:Name="ContinueButton" Click="ContinueButton_Click"
                        Cursor="Hand" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource AccentBlueBrush}"
                                    CornerRadius="6" Padding="18,7">
                                <TextBlock x:Name="BtnText"
                                           Text="Continue"
                                           Foreground="White"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentBlueHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
