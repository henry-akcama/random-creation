<UserControl x:Class="RandomCreation.SettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomCreation"
             Background="{DynamicResource BackgroundOuterBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Title bar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundTitleBarBrush}"
                BorderBrush="{DynamicResource BorderStandardBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Button Click="BackButton_Click" Cursor="Hand"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="← "
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14"/>
                                    <TextBlock Text="Back"
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverBackButtonBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="Settings"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Settings content ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16" MaxWidth="560">

                <!-- ══ THEME ══════════════════════════════════════════════════ -->
                <TextBlock Text="THEME"
                           Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <!-- Dark -->
                    <Border x:Name="ThemeDarkBtn"
                            Background="{DynamicResource BackgroundCardBrush}"
                            BorderBrush="{DynamicResource BorderStandardBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,8" Margin="0,0,8,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="ThemeDark_Click">
                        <TextBlock Text="Dark"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"/>
                    </Border>
                    <!-- Light -->
                    <Border x:Name="ThemeLightBtn"
                            Background="{DynamicResource BackgroundCardBrush}"
                            BorderBrush="{DynamicResource BorderStandardBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,8" Margin="0,0,8,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="ThemeLight_Click">
                        <TextBlock Text="Light"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"/>
                    </Border>
                    <!-- System -->
                    <Border x:Name="ThemeSystemBtn"
                            Background="{DynamicResource BackgroundCardBrush}"
                            BorderBrush="{DynamicResource BorderStandardBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="16,8"
                            Cursor="Hand"
                            MouseLeftButtonUp="ThemeSystem_Click">
                        <TextBlock Text="System Default"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"/>
                    </Border>
                </StackPanel>

                <!-- ══ FONT SIZE ══════════════════════════════════════════════ -->
                <TextBlock Text="FONT SIZE"
                           Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <!-- Slider -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="FontSizeSlider"
                            Grid.Column="0" Grid.ColumnSpan="3"
                            Minimum="0" Maximum="2" SmallChange="1" LargeChange="1"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="FontSizeSlider_ValueChanged"
                            Margin="0,0,0,4"/>
                </Grid>
                <!-- Slider labels -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Normal"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="1" Text="Large"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Extra Large"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Live preview -->
                <Border Background="{DynamicResource BackgroundCardBrush}"
                        BorderBrush="{DynamicResource BorderStandardBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="12,10" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="PREVIEW"
                                   Foreground="{DynamicResource TextSectionLabelBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   Margin="0,0,0,8"/>
                        <!-- Sample category row -->
                        <Border Background="{DynamicResource BackgroundOuterBrush}"
                                BorderBrush="{DynamicResource BorderStandardBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="10,7" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PreviewCategoryText"
                                           Grid.Column="0"
                                           Text="Sample Category"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"/>
                                <TextBlock Grid.Column="1"
                                           Text="6"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>
                                <Border Grid.Column="2"
                                        Background="{DynamicResource PillOnBackgroundBrush}"
                                        BorderBrush="{DynamicResource PillOnBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="ON"
                                               Foreground="{DynamicResource PillOnForegroundBrush}"
                                               FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Sample result card -->
                        <Border Background="{DynamicResource BackgroundOuterBrush}"
                                BorderBrush="{DynamicResource BorderStandardBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="10,8" Width="180"
                                HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock x:Name="PreviewCardCategory"
                                           Text="Head"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12"/>
                                <TextBlock x:Name="PreviewCardOption"
                                           Text="Horned"
                                           Foreground="{DynamicResource ResultOptionBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══ HISTORY ════════════════════════════════════════════════ -->
                <TextBlock Text="HISTORY"
                           Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <!-- History limit -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="History limit"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"/>
                        <TextBlock x:Name="HistoryLimitDescription"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="HistoryLimitToggle"
                            Grid.Column="1"
                            Click="HistoryLimitToggle_Click"
                            Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource ButtonDarkBrush}"
                                        BorderBrush="{DynamicResource BorderStandardBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" Padding="12,6">
                                    <TextBlock x:Name="LimitBtnText"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Clear all history -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Clear all history"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"/>
                        <TextBlock Text="Permanently delete all generation history"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Click="ClearHistoryButton_Click"
                            Grid.Column="1"
                            Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource ButtonDarkBrush}"
                                        BorderBrush="{DynamicResource BorderStandardBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" Padding="12,6">
                                    <TextBlock Text="Clear All"
                                               Foreground="{DynamicResource DeleteForegroundBrush}"
                                               FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ══ BEHAVIOR ═══════════════════════════════════════════════ -->
                <TextBlock Text="BEHAVIOR"
                           Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Confirm on delete"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"/>
                        <TextBlock Text="Show confirmation before deleting categories, options, collections, presets and history"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <local:PillToggle x:Name="ConfirmDeleteToggle"
                                      Grid.Column="1"
                                      IsOn="True"
                                      Toggled="ConfirmDeleteToggle_Toggled"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"/>
                </Grid>

                <!-- ══ WINDOW ════════════════════════════════════════════════ -->
                <TextBlock Text="WINDOW"
                           Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reset window size"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"/>
                        <TextBlock Text="Resets window and sidebar to default dimensions (1050 × 700)"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Click="ResetWindowButton_Click"
                            Grid.Column="1"
                            Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{DynamicResource ButtonDarkBrush}"
                                        BorderBrush="{DynamicResource BorderStandardBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6" Padding="12,6">
                                    <TextBlock Text="Reset"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ══ KEYBOARD SHORTCUTS ════════════════════════════════════ -->
                <TextBlock Text="KEYBOARD SHORTCUTS"
                           Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Border Background="{DynamicResource BackgroundCardBrush}"
                        BorderBrush="{DynamicResource BorderStandardBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,12" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Go back / Close dialog"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,8"/>
                        <Border Grid.Row="0" Grid.Column="1"
                                Background="{DynamicResource BackgroundOuterBrush}"
                                CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Escape"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"/>
                        </Border>

                        <!-- Row 1 -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Confirm dialog"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,8"/>
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{DynamicResource BackgroundOuterBrush}"
                                CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Enter"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"/>
                        </Border>

                        <!-- Row 2 -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Save and close"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,8"/>
                        <Border Grid.Row="2" Grid.Column="1"
                                Background="{DynamicResource BackgroundOuterBrush}"
                                CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Alt + F4"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"/>
                        </Border>

                        <!-- Row 3 -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Generate (main screen)"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,8"/>
                        <Border Grid.Row="3" Grid.Column="1"
                                Background="{DynamicResource BackgroundOuterBrush}"
                                CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Space / Enter"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"/>
                        </Border>

                        <!-- Row 4 -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Open History"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,8"/>
                        <Border Grid.Row="4" Grid.Column="1"
                                Background="{DynamicResource BackgroundOuterBrush}"
                                CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Ctrl + H"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"/>
                        </Border>

                        <!-- Row 5 -->
                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="Open Manage Content"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"/>
                        <Border Grid.Row="5" Grid.Column="1"
                                Background="{DynamicResource BackgroundOuterBrush}"
                                CornerRadius="4" Padding="8,3">
                            <TextBlock Text="Ctrl + M"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ══ ABOUT ══════════════════════════════════════════════════ -->
                <TextBlock Text="ABOUT"
                           Foreground="{DynamicResource TextSectionLabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <Border Background="{DynamicResource BackgroundCardBrush}"
                        BorderBrush="{DynamicResource BorderStandardBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Random Creation"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Margin="0,0,0,2"/>
                        <TextBlock x:Name="VersionText"
                                   Text="Version 3.0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,0,6"/>
                        <TextBlock Text="A general purpose random combination generator."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,0,14"/>

                        <!-- Changelog — loaded from data/changelog.txt at runtime -->
                        <TextBlock Text="CHANGELOG"
                                   Foreground="{DynamicResource TextSectionLabelBrush}"
                                   FontSize="10" FontWeight="Bold"
                                   Margin="0,0,0,8"/>

                        <Border Background="{DynamicResource BackgroundOuterBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer MaxHeight="320"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="ChangelogTextBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextMutedBrush}"
                                         FontSize="11"
                                         FontFamily="Consolas"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Padding="8,6"
                                         CaretBrush="Transparent"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
