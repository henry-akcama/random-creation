<UserControl x:Class="RandomCreation.ManageContentScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomCreation"
             Background="{DynamicResource BackgroundOuterBrush}">

    <UserControl.Resources>
        <!-- Dashed border style for Add Category button -->
        <Style x:Key="DashedAddButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,3">
                            <Border.BorderBrush>
                                <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute"
                                             TileMode="Tile">
                                    <DrawingBrush.Drawing>
                                        <GeometryDrawing>
                                            <GeometryDrawing.Pen>
                                                <Pen Brush="{DynamicResource AccentBlueBrush}" Thickness="1"/>
                                            </GeometryDrawing.Pen>
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0.5,0.5,7,7"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Border.BorderBrush>
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource AccentBlueBrush}"
                                       FontSize="11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ══ TITLE BAR ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundTitleBarBrush}"
                BorderBrush="{DynamicResource BorderStandardBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <Button Grid.Column="0" Click="BackButton_Click"
                        HorizontalAlignment="Left" Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="4" Padding="6,6">
                                <TextBlock Text="← Back"
                                           Foreground="{DynamicResource AccentBlueBrush}"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverDarkBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Screen title -->
                <TextBlock Grid.Column="1" Text="Manage Content"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="15" FontWeight="Medium"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,10"/>

                <!-- Presets bookmark button -->
                <Button Grid.Column="2" Click="PresetsButton_Click"
                        HorizontalAlignment="Right" Cursor="Hand"
                        VerticalAlignment="Center" ToolTip="Presets">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="4" Padding="6,6">
                                <TextBlock Text="🔖"
                                           Foreground="{DynamicResource NavIconBrush}"
                                           FontSize="14"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverDarkBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ══ TWO-PANEL LAYOUT ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="280" MaxWidth="400"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT SIDEBAR ─────────────────────────────────────────────── -->
            <Grid Grid.Column="0" Margin="8,8,4,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Collections panel -->
                    <RowDefinition Height="8"/>     <!-- Gap between panels -->
                    <RowDefinition Height="*"/>     <!-- Groups panel -->
                </Grid.RowDefinitions>

                <!-- ══ PANEL 1 — COLLECTIONS ══════════════════════════════════ -->
                <Border Grid.Row="0"
                        Background="{DynamicResource BackgroundCardBrush}"
                        BorderBrush="{DynamicResource BorderStandardBrush}"
                        BorderThickness="1" CornerRadius="8"
                        ClipToBounds="True">
                    <StackPanel>
                        <!-- Collections zone header -->
                        <Grid Background="{DynamicResource BackgroundTitleBarBrush}"
                              Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="COLLECTIONS"
                                       Foreground="{DynamicResource TextSectionLabelBrush}"
                                       FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="14,10,0,10"/>
                            <!-- Gear icon — opens CollectionsManagementScreen -->
                            <Button Grid.Column="1"
                                    Click="ManageCollectionsButton_Click"
                                    Cursor="Hand" Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Manage Collections">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="4" Padding="4,3">
                                            <Viewbox Width="14" Height="14">
                                                <Canvas Width="16" Height="16">
                                                    <Path Stroke="{DynamicResource TextMutedBrush}"
                                                          StrokeThickness="1.4"
                                                          Fill="Transparent"
                                                          Data="M 6.5,1.5 L 7.2,3.2 A 3,3 0 0 1 8.8,3.2 L 9.5,1.5
                                                                L 11,2.5 L 10.5,4.2 A 3,3 0 0 1 11.8,5.5 L 13.5,5
                                                                L 14.5,6.5 L 12.8,7.5 A 3,3 0 0 1 12.8,8.5 L 14.5,9.5
                                                                L 13.5,11 L 11.8,10.5 A 3,3 0 0 1 10.5,11.8 L 11,13.5
                                                                L 9.5,14.5 L 8.8,12.8 A 3,3 0 0 1 7.2,12.8 L 6.5,14.5
                                                                L 5,13.5 L 5.5,11.8 A 3,3 0 0 1 4.2,10.5 L 2.5,11
                                                                L 1.5,9.5 L 3.2,8.5 A 3,3 0 0 1 3.2,7.5 L 1.5,6.5
                                                                L 2.5,5 L 4.2,5.5 A 3,3 0 0 1 5.5,4.2 L 5,2.5 Z"/>
                                                    <Ellipse Canvas.Left="5.5" Canvas.Top="5.5"
                                                             Width="5" Height="5"
                                                             Stroke="{DynamicResource TextMutedBrush}"
                                                             StrokeThickness="1.4"
                                                             Fill="{DynamicResource BackgroundOuterBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource HoverDarkBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Collection rows -->
                        <ItemsControl x:Name="CollectionList" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="RowBorder"
                                            Tag="{Binding}"
                                            MouseLeftButtonUp="CollectionRow_Click"
                                            Cursor="Hand"
                                            Margin="6,1,6,1"
                                            Padding="0"
                                            CornerRadius="6">
                                        <Border.Background>
                                            <SolidColorBrush Color="Transparent"/>
                                        </Border.Background>
                                        <Grid Margin="8,6,8,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>  <!-- Drag handle -->
                                                <ColumnDefinition Width="*"/>     <!-- Name -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Badge -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="⠿"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"
                                                       Tag="{Binding}"
                                                       MouseMove="CollectionDragHandle_MouseMove"
                                                       Cursor="SizeAll"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- On/Off badge -->
                                            <Border Grid.Column="2"
                                                    CornerRadius="4"
                                                    Padding="5,2">
                                                <Border.Background>
                                                    <SolidColorBrush Color="#1e3a5a"/>
                                                </Border.Background>
                                                <TextBlock Text="On"
                                                           Foreground="{DynamicResource AccentBlueBrush}"
                                                           FontSize="10"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background"
                                                    Value="{DynamicResource BackgroundExpandedBrush}"/>
                                            <Setter TargetName="RowBorder" Property="BorderBrush"
                                                    Value="{DynamicResource AccentBlueBrush}"/>
                                            <Setter TargetName="RowBorder" Property="BorderThickness"
                                                    Value="2,0,0,0"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock x:Name="CollectionsEmptyText"
                                   Text="No collections enabled. Use Manage Collections to add one."
                                   Foreground="{DynamicResource EmptyStateBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="14,6,14,10"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- ══ PANEL 2 — GROUPS AND CATEGORIES ════════════════════════ -->
                <Border Grid.Row="2"
                        Background="{DynamicResource BackgroundCardBrush}"
                        BorderBrush="{DynamicResource BorderStandardBrush}"
                        BorderThickness="1" CornerRadius="8"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Zone header -->
                            <RowDefinition Height="Auto"/>  <!-- Search bar -->
                            <RowDefinition Height="Auto"/>  <!-- Bulk controls -->
                            <RowDefinition Height="*"/>     <!-- Group+category list -->
                        </Grid.RowDefinitions>

                        <!-- Groups zone header -->
                        <Grid Grid.Row="0" Background="{DynamicResource BackgroundTitleBarBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GroupsZoneLabel"
                                       Grid.Column="0"
                                       Text="GROUPS"
                                       Foreground="{DynamicResource TextSectionLabelBrush}"
                                       FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="14,10,0,10"/>
                            <!-- Add Group button -->
                            <Button x:Name="AddGroupButton"
                                    Grid.Column="1"
                                    Click="AddGroupButton_Click"
                                    Cursor="Hand" Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Add Group">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent"
                                                CornerRadius="4" Padding="4,2">
                                            <TextBlock Text="＋"
                                                       Foreground="{DynamicResource AccentBlueBrush}"
                                                       FontSize="14" FontWeight="Bold"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource HoverDarkBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Search bar -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource BackgroundOuterBrush}"
                                CornerRadius="6" Margin="8,6,8,2" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchBox"
                                         Grid.Column="0"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         FontSize="12"
                                         VerticalAlignment="Center"
                                         TextChanged="SearchBox_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Style.Resources>
                                                <VisualBrush x:Key="Placeholder" TileMode="None"
                                                             Opacity="0.4" Stretch="None"
                                                             AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Search groups/categories…"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="12"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Background" Value="{StaticResource Placeholder}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <Button x:Name="ClearSearchButton"
                                        Grid.Column="1"
                                        Click="ClearSearchButton_Click"
                                        Cursor="Hand"
                                        Visibility="Collapsed">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="✕"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Bulk controls — Enable All / Disable All groups -->
                        <StackPanel x:Name="GroupBulkControls"
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,4,12,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="Enable All"
                                       Foreground="{DynamicResource ResultOptionBrush}"
                                       FontSize="10" Cursor="Hand"
                                       Margin="0,0,4,0"
                                       MouseLeftButtonUp="BulkEnableGroups_Click"/>
                            <TextBlock Text="|"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="10" Margin="0,0,4,0"/>
                            <TextBlock Text="Disable All"
                                       Foreground="{DynamicResource ResultOptionBrush}"
                                       FontSize="10" Cursor="Hand"
                                       MouseLeftButtonUp="BulkDisableGroups_Click"/>
                        </StackPanel>

                        <!-- Group + category list -->
                        <ScrollViewer x:Name="GroupsScrollViewer"
                                      Grid.Row="3"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,4,0,4"
                                      PreviewMouseDown="GroupsList_PreviewMouseDown"
                                      PreviewMouseMove="GroupsList_PreviewMouseMove">
                            <ItemsControl x:Name="GroupsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Group row + categories -->
                                        <StackPanel x:Name="GroupOuterStack">
                                            <!-- Group header row -->
                                            <Border x:Name="GroupRowBorder"
                                                    Tag="{Binding}"
                                                    MouseLeftButtonUp="GroupRow_Click"
                                                    Cursor="Hand"
                                                    Margin="6,1,6,0"
                                                    CornerRadius="6">
                                                <Grid Margin="8,6,8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>  <!-- Drag handle -->
                                                        <ColumnDefinition Width="Auto"/>  <!-- Chevron -->
                                                        <ColumnDefinition Width="*"/>     <!-- Name -->
                                                        <ColumnDefinition Width="Auto"/>  <!-- Count -->
                                                        <ColumnDefinition Width="Auto"/>  <!-- On/Off pill -->
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="⠿"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"
                                                               Tag="{Binding}"
                                                               MouseMove="GroupDragHandle_MouseMove"
                                                               Cursor="SizeAll"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Chevron}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding NameUpper}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="12" FontWeight="Medium"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding CategoryCount}"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0,6,0"/>
                                                    <local:PillToggle Grid.Column="4"
                                                                      IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                                      Tag="{Binding}"
                                                                      Toggled="GroupToggle_Toggled"/>
                                                </Grid>
                                            </Border>

                                            <!-- Expanded content — Add Category + category rows -->
                                            <StackPanel Visibility="{Binding ExpandedVisibility}">
                                                <!-- Add Category dashed button -->
                                                <Button Content="＋ Add Category"
                                                        Style="{StaticResource DashedAddButton}"
                                                        Tag="{Binding}"
                                                        Click="AddCategoryInGroup_Click"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,3,12,3"/>

                                                <!-- Category rows -->
                                                <ItemsControl x:Name="CategorySubList"
                                                              ItemsSource="{Binding CategoryViewModels}"
                                                              PreviewMouseDown="CategorySubList_PreviewMouseDown"
                                                              PreviewMouseMove="CategorySubList_PreviewMouseMove">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel x:Name="CatOuterStack">
                                                                <!-- Category row -->
                                                                <Border x:Name="CatRowBorder"
                                                                        Tag="{Binding}"
                                                                        MouseLeftButtonUp="CategoryRow_Click"
                                                                        Cursor="Hand"
                                                                        Margin="6,1,6,0"
                                                                        Padding="12,0,0,0"
                                                                        CornerRadius="6">
                                                                    <Grid Margin="8,5,8,5">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="⠿"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,5,0"
                                                                                   Tag="{Binding}"
                                                                                   MouseMove="CategoryDragHandle_MouseMove"
                                                                                   Cursor="SizeAll"/>
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Name}"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding OptionCount}"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="5,0,6,0"/>
                                                                        <local:PillToggle Grid.Column="3"
                                                                                          IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                                                          Tag="{Binding}"
                                                                                          Toggled="CategoryToggle_Toggled"/>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Inline edit sub-row -->
                                                                <Border Visibility="{Binding SubRowVisibility}"
                                                                        Background="{DynamicResource BackgroundOuterBrush}"
                                                                        CornerRadius="0,0,6,6"
                                                                        Margin="6,0,6,2"
                                                                        Padding="20,5,8,5">
                                                                    <Grid>
                                                                        <TextBlock Text="{Binding RenameLabel}"
                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"/>
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    HorizontalAlignment="Right">
                                                                            <Button Tag="{Binding}"
                                                                                    Click="RenameCategoryButton_Click"
                                                                                    Cursor="Hand" Margin="0,0,4,0">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <TextBlock Text="✎"
                                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                                   FontSize="13"/>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                            <Button Tag="{Binding}"
                                                                                    Click="DeleteCategoryButton_Click"
                                                                                    Cursor="Hand">
                                                                                <Button.Template>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <TextBlock Text="🗑"
                                                                                                   Foreground="{DynamicResource DeleteForegroundBrush}"
                                                                                                   FontSize="13"/>
                                                                                    </ControlTemplate>
                                                                                </Button.Template>
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="CatRowBorder" Property="Background"
                                                                            Value="{DynamicResource BackgroundExpandedBrush}"/>
                                                                    <Setter TargetName="CatRowBorder" Property="BorderBrush"
                                                                            Value="{DynamicResource AccentBlueBrush}"/>
                                                                    <Setter TargetName="CatRowBorder" Property="BorderThickness"
                                                                            Value="2,0,0,0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                                    <Setter TargetName="CatOuterStack" Property="Opacity" Value="0.35"/>
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="GroupRowBorder" Property="Background"
                                                        Value="{DynamicResource BackgroundExpandedBrush}"/>
                                                <Setter TargetName="GroupRowBorder" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBlueBrush}"/>
                                                <Setter TargetName="GroupRowBorder" Property="BorderThickness"
                                                        Value="2,0,0,0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                                <Setter TargetName="GroupOuterStack" Property="Opacity" Value="0.35"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Groups empty state -->
                        <TextBlock x:Name="GroupsEmptyText"
                                   Grid.Row="3"
                                   Text="No groups yet. Click ＋ to add one."
                                   Foreground="{DynamicResource EmptyStateBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Margin="14,8,14,8"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderStandardBrush}"
                          Cursor="SizeWE"
                          DragCompleted="Splitter_DragCompleted">
                <GridSplitter.Style>
                    <Style TargetType="GridSplitter">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource AccentBlueBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>

            <!-- ── RIGHT PANEL ───────────────────────────────────────────────── -->
            <Grid Grid.Column="2" Margin="8,8,8,8">

                <!-- State 1: Default — nothing selected -->
                <TextBlock x:Name="SelectItemText"
                           Text="Select a group to view its details&#x0a;or click a category to view its options"
                           Foreground="{DynamicResource EmptyStateBrush}"
                           FontSize="13" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Visible"/>

                <!-- State 2: Group Detail -->
                <Grid x:Name="GroupDetailPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column — group info -->
                    <StackPanel Grid.Column="0">
                        <!-- Group name + rename -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GroupDetailName"
                                       Grid.Column="0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="RenameGroupButton"
                                    Grid.Column="1"
                                    Click="RenameGroupButton_Click"
                                    Cursor="Hand" Margin="6,0,0,0" ToolTip="Rename group">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock Text="✎"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="14"/>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- On/Off pill -->
                        <local:PillToggle x:Name="GroupDetailToggle"
                                          Toggled="GroupDetailToggle_Toggled"
                                          Margin="0,0,0,10"
                                          HorizontalAlignment="Left"/>

                        <!-- Divider -->
                        <Border Background="{DynamicResource BorderStandardBrush}"
                                Height="1" Margin="0,0,0,10"/>

                        <!-- Stats -->
                        <TextBlock x:Name="GroupDetailStats"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <!-- Divider -->
                        <Border Background="{DynamicResource BorderStandardBrush}"
                                Height="1" Margin="0,0,0,10"/>

                        <!-- Delete Group -->
                        <Button Click="DeleteGroupButton_Click" Cursor="Hand"
                                HorizontalAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="6" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑 "
                                                       Foreground="{DynamicResource DeleteForegroundBrush}"
                                                       FontSize="13"/>
                                            <TextBlock Text="Delete Group"
                                                       Foreground="{DynamicResource DeleteForegroundBrush}"
                                                       FontSize="13"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource HoverDarkBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Right column — categories in group -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="CATEGORIES"
                                       Foreground="{DynamicResource TextSectionLabelBrush}"
                                       FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button Content="＋ Add Category"
                                    Style="{StaticResource DashedAddButton}"
                                    Click="AddCategoryInGroupDetail_Click"
                                    HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Category list in group detail -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="GroupDetailCategoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Tag="{Binding}"
                                                MouseLeftButtonUp="GroupDetailCategoryRow_Click"
                                                Cursor="Hand"
                                                Margin="0,1,0,1"
                                                CornerRadius="6"
                                                Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="⠿"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           Cursor="SizeAll"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding OptionCount}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="5,0,6,0"/>
                                                <local:PillToggle Grid.Column="3"
                                                                  IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Tag="{Binding}"
                                                                  Toggled="CategoryToggle_Toggled"
                                                                  Margin="0,0,6,0"/>
                                                <Button Grid.Column="4"
                                                        Tag="{Binding}"
                                                        Click="RenameCategoryButton_Click"
                                                        Cursor="Hand" Margin="0,0,6,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock Text="✎"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="13"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Grid.Column="5"
                                                        Tag="{Binding}"
                                                        Click="DeleteCategoryButton_Click"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock Text="🗑"
                                                                       Foreground="{DynamicResource DeleteForegroundBrush}"
                                                                       FontSize="13"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- State 3: Options panel -->
                <Grid x:Name="OptionsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Options header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="RightPanelTitle"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="16" FontWeight="SemiBold"/>
                            <StackPanel x:Name="OptionBulkControls"
                                        Orientation="Horizontal"
                                        Margin="0,3,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="Enable All"
                                           Foreground="{DynamicResource ResultOptionBrush}"
                                           FontSize="10" Cursor="Hand"
                                           Margin="0,0,4,0"
                                           MouseLeftButtonUp="BulkEnableOptions_Click"/>
                                <TextBlock Text="|"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10" Margin="0,0,4,0"/>
                                <TextBlock Text="Disable All"
                                           Foreground="{DynamicResource ResultOptionBrush}"
                                           FontSize="10" Cursor="Hand"
                                           MouseLeftButtonUp="BulkDisableOptions_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="AddOptionButton"
                                Grid.Column="1"
                                Click="AddOptionButton_Click"
                                Cursor="Hand"
                                Visibility="Collapsed">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource AccentBlueBrush}"
                                            CornerRadius="6" Padding="12,6">
                                        <TextBlock Text="＋ Add option"
                                                   Foreground="White" FontSize="12"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource AccentBlueHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Options list -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="OptionsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Visibility="Collapsed"
                                      PreviewMouseDown="OptionsList_PreviewMouseDown"
                                      PreviewMouseMove="OptionsList_PreviewMouseMove">
                            <ItemsControl x:Name="OptionsList"
                                          Drop="OptionsList_Drop"
                                          AllowDrop="True">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="OptRowBorder"
                                                Tag="{Binding}"
                                                MouseLeftButtonUp="OptionRow_Click"
                                                Cursor="Hand"
                                                Margin="0,1,0,1"
                                                CornerRadius="6"
                                                Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="⠿"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,5,0"
                                                           Tag="{Binding}"
                                                           MouseMove="OptionDragHandle_MouseMove"
                                                           Cursor="SizeAll"/>
                                                <local:PillToggle Grid.Column="1"
                                                                  IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                                  Tag="{Binding}"
                                                                  Toggled="OptionToggle_Toggled"
                                                                  Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                                <Border Grid.Column="3"
                                                        Tag="{Binding}"
                                                        MouseLeftButtonUp="WeightBadge_Click"
                                                        CornerRadius="4" Padding="5,2"
                                                        Margin="6,0,4,0" Cursor="Hand"
                                                        Background="{Binding WeightBackground}">
                                                    <TextBlock Text="{Binding WeightLabel}"
                                                               Foreground="{Binding WeightForeground}"
                                                               FontSize="10"/>
                                                </Border>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding PercentageDisplay}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,6,0" Width="32"
                                                           TextAlignment="Right"/>
                                                <Button Grid.Column="5"
                                                        Tag="{Binding}"
                                                        Click="EditOptionButton_Click"
                                                        Cursor="Hand" Margin="0,0,4,0">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock Text="✎"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontSize="13"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Grid.Column="6"
                                                        Tag="{Binding}"
                                                        Click="DeleteOptionButton_Click"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <TextBlock Text="🗑"
                                                                       Foreground="{DynamicResource DeleteForegroundBrush}"
                                                                       FontSize="13"/>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="OptRowBorder" Property="Background"
                                                        Value="{DynamicResource BackgroundExpandedBrush}"/>
                                                <Setter TargetName="OptRowBorder" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBlueBrush}"/>
                                                <Setter TargetName="OptRowBorder" Property="BorderThickness"
                                                        Value="2,0,0,0"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="OptionsEmptyText"
                                   Text="No options yet. Click ＋ Add option to get started."
                                   Foreground="{DynamicResource EmptyStateBrush}"
                                   FontSize="12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="SelectCategoryText"
                                   Text="Select a category to view its options."
                                   Foreground="{DynamicResource EmptyStateBrush}"
                                   FontSize="12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Drag overlay canvas — full screen, hidden when not dragging -->
        <Canvas x:Name="DragOverlay"
                Grid.RowSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>
    </Grid>
</UserControl>
