<Window x:Class="CreatureCrafter.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#2a2a2e" Foreground="#e0e0e0"
        Width="360" Height="160"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0"
                   Foreground="#c0c0c8" FontSize="13"
                   Margin="0,0,0,8"/>

        <TextBox x:Name="InputBox" Grid.Row="1"
                 Background="#1c1c1e" Foreground="#e0e0e0"
                 BorderBrush="#3a3a3c" BorderThickness="1"
                 FontSize="14" Padding="8,6"
                 CaretBrush="#e0e0e0"
                 KeyDown="InputBox_KeyDown"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Click="CancelButton_Click"
                    Background="#3a3a3c" Foreground="#e0e0e0"
                    BorderBrush="Transparent" Padding="14,6"
                    Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="OK" Click="OkButton_Click"
                    Background="#0a84ff" Foreground="White"
                    BorderBrush="Transparent" Padding="14,6"
                    Cursor="Hand" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>