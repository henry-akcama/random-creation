<UserControl x:Class="CreatureCrafter.HistoryScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CreatureCrafter"
             Background="#1c1c1e">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="#161618"
                BorderBrush="#3a3a3c" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Button Click="BackButton_Click"
                        Cursor="Hand"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="← " Foreground="#0a84ff" FontSize="14"/>
                                    <TextBlock Text="Back" Foreground="#0a84ff" FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1a2a3a"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="History" Foreground="#e0e0e0"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Full history list -->
        <ScrollViewer Grid.Row="1" Margin="16" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:HistoryEntry}">
                        <Border Background="#2a2a2e" CornerRadius="8"
                                BorderBrush="#3a3a3c" BorderThickness="1"
                                Padding="14,10" Margin="0,0,0,6"
                                Cursor="Hand"
                                MouseLeftButtonUp="HistoryItem_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                         Fill="{Binding DotColor}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Summary}"
                                           Foreground="#d0d0d8" FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding FullTimestamp}"
                                           Foreground="#a0a0a8" FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>