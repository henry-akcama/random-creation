<Window x:Class="CreatureCrafter.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="#2a2a2e"
        Width="380" Height="180"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#2a2a2e" CornerRadius="10"
            BorderBrush="#3a3a3c" BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText" Grid.Row="0"
                       Text="Confirm Delete"
                       Foreground="#e0e0e0" FontSize="15" FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- Message -->
            <TextBlock x:Name="MessageText" Grid.Row="1"
                       Foreground="#c0c0c8" FontSize="13"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Click="NoButton_Click" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#3a3a3c"
                                    CornerRadius="6" Padding="18,7">
                                <TextBlock Text="No" Foreground="#e0e0e0" FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#4a4a4e"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Click="YesButton_Click" Cursor="Hand" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#e05050"
                                    CornerRadius="6" Padding="18,7">
                                <TextBlock Text="Yes, Delete" Foreground="White" FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#cc3a3a"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
