<Window x:Class="RandomCreation.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        SizeToContent="Height">

    <Border Background="{DynamicResource DialogBackgroundBrush}"
            CornerRadius="10"
            BorderBrush="{DynamicResource DialogBorderBrush}"
            BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText" Grid.Row="0"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="15" FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <!-- Prompt -->
            <TextBlock x:Name="PromptText" Grid.Row="1"
                       Foreground="{DynamicResource TextSectionLabelBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <!-- Input box -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BackgroundInputBrush}"
                    BorderBrush="{DynamicResource BorderStandardBrush}"
                    BorderThickness="1" CornerRadius="6">
                <TextBox x:Name="InputBox"
                         Background="Transparent"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderThickness="0"
                         FontSize="14" Padding="8,6"
                         CaretBrush="{DynamicResource TextPrimaryBrush}"
                         KeyDown="InputBox_KeyDown"
                         TextChanged="InputBox_TextChanged"/>
            </Border>

            <!-- Inline validation error — hidden until needed -->
            <TextBlock x:Name="ErrorText" Grid.Row="3"
                       Foreground="#e05050"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,5,0,0"
                       Visibility="Collapsed"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0">

                <!-- Cancel -->
                <Button Click="CancelButton_Click"
                        Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource ButtonDarkBrush}"
                                    CornerRadius="6" Padding="18,7">
                                <TextBlock Text="Cancel"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- OK -->
                <Button x:Name="OkButton" Click="OkButton_Click"
                        Cursor="Hand" IsDefault="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource AccentBlueBrush}"
                                    CornerRadius="6" Padding="18,7">
                                <TextBlock Text="OK"
                                           Foreground="White"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentBlueHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
