<UserControl x:Class="RandomCreation.CollectionsManagementScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomCreation"
             Background="{DynamicResource BackgroundOuterBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>   <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundTitleBarBrush}"
                BorderBrush="{DynamicResource BorderStandardBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">

                <!-- Back button -->
                <Button Click="BackButton_Click" Cursor="Hand"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="← "
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14"/>
                                    <TextBlock Text="Back"
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverBackButtonBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Title -->
                <TextBlock Text="Collections"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Add Collection button -->
                <Button Click="AddCollectionButton_Click" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource AccentBlueBrush}"
                                    CornerRadius="8" Padding="12,6">
                                <TextBlock Text="＋  Add Collection"
                                           Foreground="White"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentBlueHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock x:Name="EmptyText"
                       Text="No collections yet. Add one to get started."
                       Foreground="{DynamicResource EmptyStateBrush}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- Collections list -->
            <ScrollViewer Margin="16"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CollectionsList"
                              AllowDrop="True"
                              Drop="CollectionsList_Drop"
                              PreviewMouseLeftButtonDown="CollectionsList_PreviewMouseDown"
                              PreviewMouseMove="CollectionsList_PreviewMouseMove">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CollectionManagementViewModel}">
                            <Border Background="{DynamicResource BackgroundCardBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderStandardBrush}"
                                    BorderThickness="1"
                                    Padding="12,10" Margin="0,0,0,8"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>  <!-- Drag handle -->
                                        <ColumnDefinition Width="*"/>     <!-- Info -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Toggle -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Toggle label -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Rename -->
                                        <ColumnDefinition Width="Auto"/>  <!-- Delete -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Drag handle -->
                                    <TextBlock Grid.Column="0"
                                               Text="⠿"
                                               Foreground="{DynamicResource BorderSelectedBrush}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Cursor="SizeAll"
                                               Tag="{Binding}"
                                               MouseMove="DragHandle_MouseMove"/>

                                    <!-- Collection name + stats -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding StatsLabel}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- ON/OFF pill toggle -->
                                    <local:PillToggle Grid.Column="2"
                                                      IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                                      Toggled="CollectionToggle_Toggled"
                                                      Tag="{Binding}"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0,6,0"/>

                                    <!-- Rename button -->
                                    <Button Grid.Column="4"
                                            Click="RenameCollectionButton_Click"
                                            Tag="{Binding}"
                                            Cursor="Hand" ToolTip="Rename">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent"
                                                        CornerRadius="4" Padding="6,4">
                                                    <TextBlock Text="✎"
                                                               Foreground="{DynamicResource ResultOptionBrush}"
                                                               FontSize="14"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource HoverDarkBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Delete button -->
                                    <Button Grid.Column="5"
                                            Click="DeleteCollectionButton_Click"
                                            Tag="{Binding}"
                                            Cursor="Hand" ToolTip="Delete">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent"
                                                        CornerRadius="4" Padding="6,4">
                                                    <TextBlock Text="🗑"
                                                               Foreground="{DynamicResource DeleteForegroundBrush}"
                                                               FontSize="14"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource HoverDarkBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Row hover -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource BorderSelectedBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
