<UserControl x:Class="RandomCreation.HistoryScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomCreation"
             Background="{DynamicResource BackgroundOuterBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Title bar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundTitleBarBrush}"
                BorderBrush="{DynamicResource BorderStandardBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">

                <!-- Back button -->
                <Button Click="BackButton_Click"
                        Cursor="Hand"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="← "
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14"/>
                                    <TextBlock Text="Back"
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverBackButtonBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Title -->
                <TextBlock Text="History"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Clear All button — right side -->
                <Button Click="ClearAllButton_Click"
                        Cursor="Hand"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource ButtonDarkBrush}"
                                    CornerRadius="6" Padding="12,5">
                                <TextBlock Text="Clear All"
                                           Foreground="{DynamicResource DeleteForegroundBrush}"
                                           FontSize="12"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content area ── -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock x:Name="EmptyText"
                       Text="No history yet. Hit Generate to get started."
                       Foreground="{DynamicResource EmptyStateBrush}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- History list -->
            <ScrollViewer Margin="16"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HistoryEntry}">
                            <Border Background="{DynamicResource BackgroundCardBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderStandardBrush}"
                                    BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,6"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="HistoryItem_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Dot -->
                                    <Ellipse Grid.Column="0"
                                             Width="8" Height="8"
                                             Fill="{Binding DotColor}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>

                                    <!-- Summary -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Summary}"
                                               Foreground="{DynamicResource TextHistoryBrush}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FullTimestamp}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="16,0,8,0"/>

                                    <!-- Delete button -->
                                    <Button Grid.Column="3"
                                            Click="DeleteHistoryItem_Click"
                                            Tag="{Binding}"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        CornerRadius="4"
                                                        Padding="6,3">
                                                    <TextBlock Text="🗑"
                                                               Foreground="{DynamicResource DeleteForegroundBrush}"
                                                               FontSize="14"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource HoverDarkBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Row hover style -->
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource BorderSelectedBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
