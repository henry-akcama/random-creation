<UserControl x:Class="RandomCreation.PresetsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomCreation"
             Background="{DynamicResource BackgroundOuterBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>  <!-- Title bar -->
            <RowDefinition Height="*"/>   <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundTitleBarBrush}"
                BorderBrush="{DynamicResource BorderStandardBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">

                <!-- Back button -->
                <Button Click="BackButton_Click" Cursor="Hand"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="← "
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14"/>
                                    <TextBlock Text="Back"
                                               Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverBackButtonBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Title -->
                <TextBlock Text="Presets"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Save Current button -->
                <Button Click="SaveCurrentButton_Click" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource AccentBlueBrush}"
                                    CornerRadius="8" Padding="12,6">
                                <TextBlock Text="＋  Save Current"
                                           Foreground="White"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentBlueHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1">

            <!-- Empty state -->
            <TextBlock x:Name="EmptyText"
                       Text="No presets yet. Hit Save Current to create one."
                       Foreground="{DynamicResource EmptyStateBrush}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- Presets list -->
            <ScrollViewer Margin="16"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PresetsList"
                              AllowDrop="True"
                              Drop="PresetsList_Drop"
                              PreviewMouseLeftButtonDown="PresetsList_PreviewMouseDown"
                              PreviewMouseMove="PresetsList_PreviewMouseMove">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PresetViewModel}">
                            <Border Background="{DynamicResource BackgroundCardBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderStandardBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,0,8"
                                    Tag="{Binding}">
                                <StackPanel>

                                    <!-- ── Collapsed header row ── -->
                                    <Border Padding="12,10"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="PresetHeader_Click"
                                            Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>  <!-- Drag -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Chevron -->
                                                <ColumnDefinition Width="*"/>     <!-- Name + summary -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Load -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Rename -->
                                                <ColumnDefinition Width="Auto"/>  <!-- Delete -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Drag handle -->
                                            <TextBlock Grid.Column="0"
                                                       Text="⠿"
                                                       Foreground="{DynamicResource BorderSelectedBrush}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"
                                                       Cursor="SizeAll"
                                                       Tag="{Binding}"
                                                       MouseMove="DragHandle_MouseMove"/>

                                            <!-- Expand chevron -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Chevron}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>

                                            <!-- Name + summary -->
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           FontSize="14" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Summary}"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Load button -->
                                            <Button Grid.Column="3"
                                                    Click="LoadPresetButton_Click"
                                                    Tag="{Binding}"
                                                    Cursor="Hand"
                                                    Margin="8,0,4,0"
                                                    VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd"
                                                                Background="{DynamicResource PillOnBackgroundBrush}"
                                                                BorderBrush="{DynamicResource PillOnBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6" Padding="10,4">
                                                            <TextBlock Text="Load"
                                                                       Foreground="{DynamicResource PillOnForegroundBrush}"
                                                                       FontSize="12" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource HoverDarkBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Rename button -->
                                            <Button Grid.Column="4"
                                                    Click="RenamePresetButton_Click"
                                                    Tag="{Binding}"
                                                    Cursor="Hand" ToolTip="Rename"
                                                    VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                CornerRadius="4" Padding="6,4">
                                                            <TextBlock Text="✎"
                                                                       Foreground="{DynamicResource ResultOptionBrush}"
                                                                       FontSize="14"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource HoverDarkBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- Delete button -->
                                            <Button Grid.Column="5"
                                                    Click="DeletePresetButton_Click"
                                                    Tag="{Binding}"
                                                    Cursor="Hand" ToolTip="Delete"
                                                    VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                CornerRadius="4" Padding="6,4">
                                                            <TextBlock Text="🗑"
                                                                       Foreground="{DynamicResource DeleteForegroundBrush}"
                                                                       FontSize="14"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background"
                                                                        Value="{DynamicResource HoverDarkBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <!-- Header hover -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource HoverDarkBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- ── Expanded detail area ── -->
                                    <Border Visibility="{Binding ExpandedVisibility}"
                                            Background="{DynamicResource BackgroundExpandedBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="16,10"
                                            CornerRadius="0,0,8,8">
                                        <ItemsControl ItemsSource="{Binding CollectionDisplayInfo}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:PresetCollectionDisplayInfo}">
                                                    <Grid Margin="0,3,0,3"
                                                          Opacity="{Binding RowOpacity}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Collection name -->
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding CollectionName}"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   FontSize="13" FontWeight="Medium"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- Stats label -->
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding StatsLabel}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
