<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RandomCreation</AssemblyName>
    <RootNamespace>RandomCreation</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <!-- ── Theme resource dictionaries — copy to output so they load at runtime ── -->
  <ItemGroup>
    <Resource Include="Themes\DarkTheme.xaml"/>
    <Resource Include="Themes\LightTheme.xaml"/>
  </ItemGroup>

  <!-- ── Program files — copied to output alongside the exe ── -->
  <!-- changelog.txt is a PROGRAM file (authored, shipped, replaced every
       release) and lands beside the exe, never in the data folder — the
       data folder belongs to the user and may not even be here (installed
       builds keep it in %LocalAppData%). portable.txt is the marker that
       makes a build portable: shipped in the zip, excluded by the
       installer script. -->
  <ItemGroup>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="changelog.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="portable.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ── Sample content — shipped as an example, NOT as live data ── -->
  <!-- Deliberately lands in 'samples', never 'data'. A release that wrote
       data\categories.json would overwrite a user's entire content the
       first time they installed an update over their existing folder.
       The APP copies it into the data folder at startup, and only when no
       categories.json exists there — a conditional install can never
       overwrite user content. -->
  <ItemGroup>
    <Content Include="SampleData\categories.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>samples\categories.json</TargetPath>
    </Content>
  </ItemGroup>

  <!-- ── Data folder — excluded from publish so users can back it up ── -->
  <!-- The 'data' folder is created at runtime by DataService.
       It is intentionally NOT included here so it persists across updates. -->

</Project>
