<Window x:Class="RandomCreation.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview"
        Width="900" Height="900"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="{DynamicResource BackgroundOuterBrush}"
            BorderBrush="{DynamicResource BorderStandardBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>    <!-- Paper preview -->
                <RowDefinition Height="Auto"/> <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <!-- Page-accurate preview — one white sheet per printed page,
                 built by the same builder the printer uses -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PagesPanel" Margin="0,0,0,0">
                    <!-- Populated by code-behind -->
                </StackPanel>
            </ScrollViewer>

            <!-- Footer buttons -->
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <Button Click="CloseButton_Click" HorizontalAlignment="Left"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource ButtonDarkBrush}"
                                    CornerRadius="6" Padding="16,7">
                                <TextBlock Text="Close"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="PrintButton_Click" HorizontalAlignment="Right"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource AccentBlueBrush}"
                                    CornerRadius="6" Padding="16,7">
                                <TextBlock Text="🖨 Print…"
                                           Foreground="White"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource AccentBlueHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
