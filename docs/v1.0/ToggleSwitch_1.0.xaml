<UserControl x:Class="CreatureCrafter.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Clickable track -->
        <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                Background="#0a84ff" Cursor="Hand"
                MouseLeftButtonUp="Track_Click">
            <!-- Thumb slides left/right via HorizontalAlignment -->
            <Border x:Name="Thumb" Width="16" Height="16"
                    CornerRadius="8" Background="White"
                    Margin="3" HorizontalAlignment="Right"/>
        </Border>
        <!-- On / Off label -->
        <TextBlock x:Name="LabelText" Text="On"
                   Foreground="#60aaff" FontSize="12"
                   VerticalAlignment="Center" Margin="6,0,0,0"/>
    </StackPanel>
</UserControl>
