<Window x:Class="CreatureCrafter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CreatureCrafter"
        Title="Creature Crafter"
        Width="1050" Height="700"
        MinWidth="750" MinHeight="550"
        Background="#1c1c1e"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- ── MAIN PANEL ── -->
        <Grid x:Name="MainPanel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#161618"
                    BorderBrush="#3a3a3c" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <TextBlock Text="Creature Crafter" Foreground="#e0e0e0"
                               FontSize="14" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- History clock icon -->
                        <Button Click="HistoryButton_Click" Cursor="Hand" ToolTip="History">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="🕗" FontSize="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2f2f35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Settings / edit icon -->
                        <Button Click="EditButton_Click" Cursor="Hand" ToolTip="Edit Categories">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="⚙" FontSize="16"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2f2f35"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Results card -->
                <Border Grid.Row="0" Background="#2a2a2e" CornerRadius="12"
                        BorderBrush="#3a3a3c" BorderThickness="1" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="LAST GENERATED RESULT"
                                   Foreground="#c0c0c8" FontSize="11" FontWeight="Bold"
                                   Margin="0,0,0,12"/>

                        <!-- Fixed 5-column UniformGrid of result cards -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ResultsGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <!-- UniformGrid enforces exactly 5 columns, top-aligned -->
                                        <UniformGrid Columns="5" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ResultPair}">
                                        <Border Background="#1c1c1e" CornerRadius="8"
                                                BorderBrush="#3a3a3c" BorderThickness="1"
                                                Padding="12,10" Margin="4"
                                                Height="70"
                                                VerticalAlignment="Top">
                                            <StackPanel VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="#e0e0e0"
                                                           FontSize="12" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Option}"
                                                           Foreground="#60aaff"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="ResultTimestamp" Grid.Row="2"
                                   Foreground="#a0a0a8" FontSize="12"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- Generate button -->
                <Button Grid.Row="1" Click="GenerateButton_Click"
                        Height="46" Margin="0,12,0,0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#0a84ff" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1a8fff"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0070e0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎲 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Generate Random Creature"
                                   Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Recent history card -->
                <Border Grid.Row="2" Background="#2a2a2e" CornerRadius="12"
                        BorderBrush="#3a3a3c" BorderThickness="1"
                        Padding="16,12" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header row -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="RECENT HISTORY"
                                       Foreground="#c0c0c8" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Click="HistoryButton_Click"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="#0a84ff" CornerRadius="6" Padding="10,4">
                                            <TextBlock Text="View all" Foreground="White" FontSize="12"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1a8fff"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Recent history rows (last 3) -->
                        <ItemsControl x:Name="RecentHistoryList" Grid.Row="1">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HistoryEntry}">
                                    <Border x:Name="RowBorder"
                                            Background="Transparent"
                                            CornerRadius="6" Padding="6,8"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="RecentHistoryItem_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="8" Height="8"
                                                     Fill="{Binding DotColor}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Summary}"
                                                       Foreground="#d0d0d8" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ShortTime}"
                                                       Foreground="#a0a0a8" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#2f2f33"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ── EDIT PANEL ── -->
        <local:EditScreen x:Name="EditPanel" Visibility="Collapsed"/>

        <!-- ── HISTORY PANEL ── -->
        <local:HistoryScreen x:Name="HistoryPanel" Visibility="Collapsed"/>
    </Grid>
</Window>