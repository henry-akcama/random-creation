<Window x:Class="RandomCreation.ResultDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomCreation"
        Title="Result Detail"
        Width="800" Height="560"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="{DynamicResource BackgroundOuterBrush}"
            BorderBrush="{DynamicResource BorderStandardBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Top bar -->
                <RowDefinition Height="*"/>     <!-- Cards -->
                <RowDefinition Height="Auto"/>  <!-- Bottom bar -->
            </Grid.RowDefinitions>

            <!-- ── Top bar ── -->
            <Border Grid.Row="0" x:Name="TopBar"
                    CornerRadius="8" Padding="12,8"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: timestamp + context -->
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="TimestampLabel"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,0,2"/>
                        <TextBlock x:Name="CollectionsLabel"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12" Margin="0,0,0,2"/>
                        <TextBlock x:Name="CountsLabel"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"/>
                    </StackPanel>

                    <!-- Right: Mark as Drawn toggle -->
                    <Button x:Name="MarkAsDrawnButton"
                            Grid.Column="1"
                            Click="MarkAsDrawnButton_Click"
                            Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="DrawnBd"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderStandardBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5" Padding="10,4">
                                    <TextBlock x:Name="DrawnText"
                                               Text="○ Mark as Drawn"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="DrawnBd" Property="Background"
                                                Value="{DynamicResource HoverDarkBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Group cards ── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="CardPanel"
                           Orientation="Horizontal"/>
            </ScrollViewer>

            <!-- ── Bottom bar ── -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <!-- Delete — left -->
                <Button Click="DeleteButton_Click" HorizontalAlignment="Left" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource ButtonDarkBrush}"
                                    CornerRadius="6" Padding="16,7">
                                <TextBlock Text="Delete Entry"
                                           Foreground="{DynamicResource DeleteForegroundBrush}"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Right: AI Prompt + Print + Close -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <!-- AI Prompt -->
                    <Button Click="AiPromptButton_Click" Cursor="Hand" Margin="0,0,6,0"
                            ToolTip="Copy AI Prompt">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource ButtonDarkBrush}"
                                        CornerRadius="6" Padding="12,7">
                                    <TextBlock Text="✦ AI Prompt"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Print -->
                    <Button Click="PrintButton_Click" Cursor="Hand" Margin="0,0,6,0"
                            ToolTip="Print Preview">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource ButtonDarkBrush}"
                                        CornerRadius="6" Padding="12,7">
                                    <TextBlock Text="🖨 Print"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Close -->
                    <Button Click="CloseButton_Click" Cursor="Hand" IsCancel="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{DynamicResource ButtonDarkBrush}"
                                        CornerRadius="6" Padding="20,7">
                                    <TextBlock Text="Close"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
