<UserControl x:Class="RandomCreation.HistoryScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RandomCreation"
             Background="{DynamicResource BackgroundOuterBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>   <!-- Title bar -->
            <RowDefinition Height="Auto"/> <!-- Filter bar -->
            <RowDefinition Height="*"/>    <!-- List -->
        </Grid.RowDefinitions>

        <!-- ── Title bar ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource BackgroundTitleBarBrush}"
                BorderBrush="{DynamicResource BorderStandardBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Button Click="BackButton_Click" Cursor="Hand"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="6" Padding="6,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="← " Foreground="{DynamicResource AccentBlueBrush}" FontSize="14"/>
                                    <TextBlock Text="Back" Foreground="{DynamicResource AccentBlueBrush}"
                                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource HoverBackButtonBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="History"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Button Click="ClearAllButton_Click" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource ButtonDarkBrush}"
                                    CornerRadius="6" Padding="12,5">
                                <TextBlock Text="Clear All"
                                           Foreground="{DynamicResource DeleteForegroundBrush}"
                                           FontSize="12"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Filter bar ── -->
        <Border Grid.Row="1"
                Background="{DynamicResource BackgroundSummaryBarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,7">
            <Grid>
                <!-- Filter pills -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- All -->
                    <Border x:Name="FilterAllPill"
                            CornerRadius="12" Padding="12,4"
                            Margin="0,0,6,0" Cursor="Hand"
                            MouseLeftButtonUp="FilterAll_Click"
                            Background="{DynamicResource AccentBlueBrush}">
                        <TextBlock Text="All" Foreground="White" FontSize="12"/>
                    </Border>
                    <!-- Drawn -->
                    <Border x:Name="FilterDrawnPill"
                            CornerRadius="12" Padding="12,4"
                            Cursor="Hand"
                            MouseLeftButtonUp="FilterDrawn_Click"
                            Background="{DynamicResource ButtonDarkBrush}">
                        <TextBlock Text="✓ Drawn" Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>

                <!-- Drawn count -->
                <TextBlock x:Name="DrawnCountText"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"/>
            </Grid>
        </Border>

        <!-- ── Content area ── -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="EmptyText"
                       Text="No history yet. Hit Generate to get started."
                       Foreground="{DynamicResource EmptyStateBrush}"
                       FontSize="13" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed"/>

            <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:HistoryEntry}">
                            <Border Background="{DynamicResource BackgroundCardBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderStandardBrush}"
                                    BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,6"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="HistoryItem_Click"
                                    Tag="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>   <!-- dot wrapper -->
                                        <ColumnDefinition Width="*"/>    <!-- summary -->
                                        <ColumnDefinition Width="Auto"/> <!-- timestamp -->
                                        <ColumnDefinition Width="Auto"/> <!-- delete -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Drawn dot — grey circle or green checkmark -->
                                    <Grid Grid.Column="0" Width="12" Height="12"
                                          VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10"
                                                 Stroke="{DynamicResource TextMutedBrush}"
                                                 StrokeThickness="1.2" Fill="Transparent"
                                                 Visibility="{Binding IsDrawn,
                                                              Converter={StaticResource BoolToVisibilityConverter},
                                                              ConverterParameter=Inverse}"/>
                                        <Path Data="M2,6 L5,9 L10,3"
                                              Stroke="#30d158" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Visibility="{Binding IsDrawn,
                                                           Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Summary}"
                                               Foreground="{DynamicResource TextHistoryBrush}"
                                               FontSize="13" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FullTimestamp}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Margin="16,0,8,0"/>

                                    <Button Grid.Column="3"
                                            Click="DeleteHistoryItem_Click"
                                            Tag="{Binding}" Cursor="Hand"
                                            VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent"
                                                        CornerRadius="4" Padding="6,3">
                                                    <TextBlock Text="🗑"
                                                               Foreground="{DynamicResource DeleteForegroundBrush}"
                                                               FontSize="14"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource HoverDarkBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource BorderSelectedBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
