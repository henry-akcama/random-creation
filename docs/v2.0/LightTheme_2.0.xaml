<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ═══════════════════════════════════════════════════════════════════════
         RANDOM CREATION — LIGHT THEME
         All color and size resources for the light UI theme.
         All resource keys match DarkTheme.xaml exactly — only values differ.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ── Backgrounds ───────────────────────────────────────────────────── -->
    <Color x:Key="BackgroundOuterColor">#f0f4f8</Color>
    <Color x:Key="BackgroundCardColor">#ffffff</Color>
    <Color x:Key="BackgroundTitleBarColor">#e2e8f0</Color>
    <Color x:Key="BackgroundSummaryBarColor">#d8e4f0</Color>
    <Color x:Key="BackgroundExpandedColor">#e8f0f8</Color>
    <Color x:Key="BackgroundInputColor">#ffffff</Color>

    <SolidColorBrush x:Key="BackgroundOuterBrush"      Color="{StaticResource BackgroundOuterColor}"/>
    <SolidColorBrush x:Key="BackgroundCardBrush"       Color="{StaticResource BackgroundCardColor}"/>
    <SolidColorBrush x:Key="BackgroundTitleBarBrush"   Color="{StaticResource BackgroundTitleBarColor}"/>
    <SolidColorBrush x:Key="BackgroundSummaryBarBrush" Color="{StaticResource BackgroundSummaryBarColor}"/>
    <SolidColorBrush x:Key="BackgroundExpandedBrush"   Color="{StaticResource BackgroundExpandedColor}"/>
    <SolidColorBrush x:Key="BackgroundInputBrush"      Color="{StaticResource BackgroundInputColor}"/>

    <!-- ── Borders ───────────────────────────────────────────────────────── -->
    <Color x:Key="BorderStandardColor">#c8d0d8</Color>
    <Color x:Key="BorderSelectedColor">#a0b0c0</Color>
    <Color x:Key="BorderSubtleColor">#d8e0e8</Color>

    <SolidColorBrush x:Key="BorderStandardBrush" Color="{StaticResource BorderStandardColor}"/>
    <SolidColorBrush x:Key="BorderSelectedBrush" Color="{StaticResource BorderSelectedColor}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"   Color="{StaticResource BorderSubtleColor}"/>

    <!-- ── Text ──────────────────────────────────────────────────────────── -->
    <Color x:Key="TextPrimaryColor">#1a2030</Color>
    <Color x:Key="TextSecondaryColor">#2a3a4a</Color>
    <Color x:Key="TextMutedColor">#7090b0</Color>
    <Color x:Key="TextSectionLabelColor">#7090b0</Color>
    <Color x:Key="TextHistoryColor">#2a3a4a</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"        Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextSectionLabelBrush" Color="{StaticResource TextSectionLabelColor}"/>
    <SolidColorBrush x:Key="TextHistoryBrush"      Color="{StaticResource TextHistoryColor}"/>

    <!-- ── Accent ─────────────────────────────────────────────────────────── -->
    <Color x:Key="AccentBlueColor">#0a84ff</Color>
    <Color x:Key="AccentBlueHoverColor">#1a8fff</Color>
    <Color x:Key="AccentBluePressedColor">#0070e0</Color>
    <Color x:Key="ResultOptionColor">#0055bb</Color>

    <SolidColorBrush x:Key="AccentBlueBrush"        Color="{StaticResource AccentBlueColor}"/>
    <SolidColorBrush x:Key="AccentBlueHoverBrush"   Color="{StaticResource AccentBlueHoverColor}"/>
    <SolidColorBrush x:Key="AccentBluePressedBrush" Color="{StaticResource AccentBluePressedColor}"/>
    <SolidColorBrush x:Key="ResultOptionBrush"      Color="{StaticResource ResultOptionColor}"/>

    <!-- ── Interactive hover / button backgrounds ────────────────────────── -->
    <Color x:Key="HoverDarkColor">#d0dae8</Color>
    <Color x:Key="HoverBackButtonColor">#c8d8e8</Color>
    <Color x:Key="ButtonDarkColor">#dde4ec</Color>
    <Color x:Key="ButtonDarkHoverColor">#ccd4e0</Color>

    <SolidColorBrush x:Key="HoverDarkBrush"       Color="{StaticResource HoverDarkColor}"/>
    <SolidColorBrush x:Key="HoverBackButtonBrush" Color="{StaticResource HoverBackButtonColor}"/>
    <SolidColorBrush x:Key="ButtonDarkBrush"      Color="{StaticResource ButtonDarkColor}"/>
    <SolidColorBrush x:Key="ButtonDarkHoverBrush" Color="{StaticResource ButtonDarkHoverColor}"/>

    <!-- ── Nav icon foreground ────────────────────────────────────────────── -->
    <Color x:Key="NavIconColor">#4a4a4e</Color>
    <Color x:Key="NavIconHoverColor">#1a2030</Color>
    <SolidColorBrush x:Key="NavIconBrush"      Color="{StaticResource NavIconColor}"/>
    <SolidColorBrush x:Key="NavIconHoverBrush" Color="{StaticResource NavIconHoverColor}"/>

    <!-- ── Window controls ───────────────────────────────────────────────── -->
    <Color x:Key="WinBtnForegroundColor">#4a4a4e</Color>
    <Color x:Key="WinBtnHoverColor">#d0dae8</Color>
    <Color x:Key="WinBtnCloseHoverColor">#c42b1c</Color>
    <SolidColorBrush x:Key="WinBtnForegroundBrush" Color="{StaticResource WinBtnForegroundColor}"/>
    <SolidColorBrush x:Key="WinBtnHoverBrush"      Color="{StaticResource WinBtnHoverColor}"/>
    <SolidColorBrush x:Key="WinBtnCloseHoverBrush" Color="{StaticResource WinBtnCloseHoverColor}"/>

    <!-- ── Weight badge colors ────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="WeightNormalBackgroundBrush" Color="#d4edd4"/>
    <SolidColorBrush x:Key="WeightNormalForegroundBrush" Color="#2e7d32"/>
    <SolidColorBrush x:Key="WeightLowBackgroundBrush"    Color="#fcecd4"/>
    <SolidColorBrush x:Key="WeightLowForegroundBrush"    Color="#b06000"/>
    <SolidColorBrush x:Key="WeightRareBackgroundBrush"   Color="#fdd4d4"/>
    <SolidColorBrush x:Key="WeightRareForegroundBrush"   Color="#c02020"/>

    <!-- ── ON/OFF pill colors ─────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="PillOnBackgroundBrush"  Color="#deeeff"/>
    <SolidColorBrush x:Key="PillOnForegroundBrush"  Color="#0055bb"/>
    <SolidColorBrush x:Key="PillOnBorderBrush"      Color="#99bbee"/>
    <SolidColorBrush x:Key="PillOffBackgroundBrush" Color="#e0e4e8"/>
    <SolidColorBrush x:Key="PillOffForegroundBrush" Color="#7090b0"/>
    <SolidColorBrush x:Key="PillOffBorderBrush"     Color="#c8d0d8"/>

    <!-- ── Collections summary bar pills ─────────────────────────────────── -->
    <SolidColorBrush x:Key="SummaryPillOnBackgroundBrush"  Color="#c8ecd0"/>
    <SolidColorBrush x:Key="SummaryPillOnForegroundBrush"  Color="#2e7d32"/>
    <SolidColorBrush x:Key="SummaryPillOffBackgroundBrush" Color="#e2e8f0"/>
    <SolidColorBrush x:Key="SummaryPillOffForegroundBrush" Color="#9090a0"/>

    <!-- ── Delete / destructive ───────────────────────────────────────────── -->
    <SolidColorBrush x:Key="DeleteForegroundBrush"      Color="#c02020"/>
    <SolidColorBrush x:Key="DeleteBackgroundBrush"      Color="#e05050"/>
    <SolidColorBrush x:Key="DeleteHoverBackgroundBrush" Color="#cc3a3a"/>

    <!-- ── Dialog ─────────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="DialogBackgroundBrush" Color="#f0f4f8"/>
    <SolidColorBrush x:Key="DialogBorderBrush"     Color="#c8d0d8"/>

    <!-- ── Drag and drop ──────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="DragInsertionLineBrush"        Color="#0a84ff"/>
    <SolidColorBrush x:Key="DragDropTargetBorderBrush"     Color="#0a84ff"/>
    <SolidColorBrush x:Key="DragDropTargetBackgroundBrush" Color="#cce0ff"/>
    <SolidColorBrush x:Key="DragSourceDimBackgroundBrush"  Color="#dde4ec"/>

    <!-- ── Scrollbar ──────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="ScrollTrackBrush"        Color="#e2e8f0"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"        Color="#b0bcc8"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush"   Color="#9090a0"/>
    <SolidColorBrush x:Key="ScrollThumbPressedBrush" Color="#0a84ff"/>

    <!-- ── Empty state text ───────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="EmptyStateBrush" Color="#7090b0"/>

    <!-- ── Transparent ────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- ── Font sizes (same as dark — scaling is theme-independent) ───────── -->
    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeLargeTitle">18</sys:Double>

    <!-- ── Base layout sizes ──────────────────────────────────────────────── -->
    <sys:Double x:Key="BaseRowHeight">38</sys:Double>
    <sys:Double x:Key="BaseCardMinHeight">70</sys:Double>
    <sys:Double x:Key="BaseCardWidth">220</sys:Double>
    <sys:Double x:Key="TitleBarHeight">44</sys:Double>
    <sys:Double x:Key="SummaryBarHeight">28</sys:Double>

    <!-- ════════════════════════════════════════════════════════════════════
         GLOBAL SCROLLBAR STYLE — matches dark theme structure, light colors
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource ScrollThumbBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{StaticResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background"
                                    Value="{StaticResource ScrollThumbPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}"
                                       Margin="1,2"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource ScrollBarStyle}"/>

    <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Column="1" Grid.Row="0"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
