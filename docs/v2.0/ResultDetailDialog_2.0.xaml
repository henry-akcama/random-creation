<Window x:Class="RandomCreation.ResultDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RandomCreation"
        Title="Result Detail"
        Width="740" Height="560"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="{DynamicResource BackgroundOuterBrush}"
            BorderBrush="{DynamicResource BorderStandardBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header — timestamp + context -->
                <RowDefinition Height="*"/>     <!-- Result cards -->
                <RowDefinition Height="Auto"/>  <!-- Footer buttons -->
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">

                <!-- Timestamp -->
                <TextBlock x:Name="TimestampLabel"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12" Margin="0,0,0,3"/>

                <!-- Collections active -->
                <TextBlock x:Name="CollectionsLabel"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12" Margin="0,0,0,3"/>

                <!-- Counts summary -->
                <TextBlock x:Name="CountsLabel"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12"/>
            </StackPanel>

            <!-- ── Result cards — read-only snapshot, no hover, no click ── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PairsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Fixed 3-column layout matching approved spec -->
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ResultPair}">
                            <!-- Cards are read-only — no cursor, no hover, no click.
                                 Dimmed cards show at reduced opacity as a static snapshot. -->
                            <Border Background="{DynamicResource BackgroundCardBrush}"
                                    CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderStandardBrush}"
                                    BorderThickness="1"
                                    Padding="12,8" Margin="4"
                                    Width="220"
                                    MinHeight="70"
                                    VerticalAlignment="Top"
                                    Opacity="{Binding IsDimmed,
                                              Converter={StaticResource DimmedToOpacityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Category}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="11" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Option}"
                                               Foreground="{DynamicResource ResultOptionBrush}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── Footer buttons ── -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <!-- Delete button — left -->
                <Button Click="DeleteButton_Click"
                        HorizontalAlignment="Left"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource ButtonDarkBrush}"
                                    CornerRadius="6" Padding="16,7">
                                <TextBlock Text="Delete Entry"
                                           Foreground="{DynamicResource DeleteForegroundBrush}"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Close button — right -->
                <Button Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Cursor="Hand" IsCancel="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{DynamicResource ButtonDarkBrush}"
                                    CornerRadius="6" Padding="20,7">
                                <TextBlock Text="Close"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="13"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource ButtonDarkHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
